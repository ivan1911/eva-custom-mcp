# Company EvaTeam instance for project/task/wiki tools.
EVA_BASE_URL=https://yourcompany.evateam.ru
EVA_API_TOKEN=

# Public EvaTeam website used by glossary tools (default shown).
# EVA_GLOSSARY_URL=https://www.evateam.ru

# Optional: directory that document_attachment_upload may read files from.
# Uploads are disabled when unset.
# EVA_UPLOAD_ROOT=/absolute/path/to/uploads
